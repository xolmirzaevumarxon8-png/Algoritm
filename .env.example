# ==========================================
# ENTERPRISE LMS V2 - PRODUCTION ENVIRONMENT
# ==========================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1

# DATABASE (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:secure_password@localhost:5432/lms_db?schema=public"

# AUTHENTICATION (JWT)
JWT_SECRET="super_secure_random_string_replace_in_prod"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="super_secure_refresh_string_replace_in_prod"

# FILE STORAGE (AWS S3)
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="lms-production-assets"

# EXTERNAL INTEGRATIONS (Optional)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your_smtp_password"

# FRONTEND CONFIGURATION
VITE_API_BASE_URL="https://api.yourdomain.com/v1"
