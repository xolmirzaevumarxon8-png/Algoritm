{
  "name": "oquv-markaz-lms",
  "version": "2.0.0",
  "private": true,
  "description": "Enterprise LMS Platform for Learning Centers & Educational Institutions",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,emerald\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "db:push": "npm run db:push --prefix backend",
    "db:generate": "npm run db:generate --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
