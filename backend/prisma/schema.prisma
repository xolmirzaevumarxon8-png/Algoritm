generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model roles {
  id         String   @id @default(uuid())
  name       String
  level      Int?
  created_at DateTime @default(now())

  users users[]
}

model branches {
  id         String   @id @default(uuid())
  name       String
  address    String?
  manager_id String?
  created_at DateTime @default(now())

  manager  users?     @relation(fields: [manager_id], references: [id], onDelete: SetNull)
  rooms    rooms[]
  teachers teachers[]
  expenses expenses[]
  students students[]
  groups   groups[]
}

model rooms {
  id        String @id @default(uuid())
  branch_id String
  name      String
  capacity  Int?
  is_deleted Boolean @default(false)

  branch branches @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  groups groups[]
}

model users {
  id            String   @id @default(uuid())
  role_id       String?
  fullname      String
  phone         String?
  email         String?
  password_hash String?
  is_active     Boolean? @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  role             roles?       @relation(fields: [role_id], references: [id], onDelete: SetNull)
  teachers         teachers[]
  call_logs        call_logs[]
  payments         payments[]
  audit_logs       audit_logs[]
  branches_managed branches[]
}

model courses {
  id             String   @id @default(uuid())
  name           String
  duration_month Int?
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())

  groups groups[]
}

model parents {
  id         String   @id @default(uuid())
  fullname   String
  phone      String?
  phone2     String?
  relation   String?
  telegram   String?
  created_at DateTime @default(now())

  students students[]
}

model students {
  id         String    @id @default(uuid())
  fullname   String
  birthday   DateTime?
  gender     String?
  phone      String?
  parent_id  String?
  branch_id  String?
  is_deleted Boolean   @default(false)
  created_at DateTime  @default(now())

  parent           parents?           @relation(fields: [parent_id], references: [id], onDelete: SetNull)
  branch           branches?          @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  student_groups   student_groups[]
  student_transfer student_transfer[]
  attendance       attendance[]
  call_logs        call_logs[]
  ratings          ratings[]
  finance_accounts finance_accounts[]
  discounts            discounts[]
  grants               grants[]
  exam_results         exam_results[]
  homework_submissions homework_submissions[]
}

model teachers {
  id                 String   @id @default(uuid())
  user_id            String
  branch_id          String?
  salary_per_student Decimal?
  is_active          Boolean? @default(true)
  is_deleted         Boolean  @default(false)
  created_at         DateTime @default(now())

  user   users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch branches? @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  groups        groups[]
  old_transfers student_transfer[] @relation("OldTeacher")
  new_transfers student_transfer[] @relation("NewTeacher")
  ratings       ratings[]
  homeworks     homeworks[]
  exams         exams[]
}

model groups {
  id              String    @id @default(uuid())
  course_id       String
  teacher_id      String?
  room_id         String?
  name            String
  start_date      DateTime?
  end_date        DateTime?
  lesson_duration Int?
  monthly_lessons Int?
  status          String?
  branch_id       String?
  stage           String?   @default("HTML")
  is_deleted      Boolean   @default(false)

  course  courses   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  teacher teachers? @relation(fields: [teacher_id], references: [id], onDelete: SetNull)
  room    rooms?    @relation(fields: [room_id], references: [id], onDelete: SetNull)
  branch  branches? @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  schedules      schedules[]
  student_groups student_groups[]
  lessons        lessons[]
  homeworks      homeworks[]
  exams          exams[]
}

model schedules {
  id         String    @id @default(uuid())
  group_id   String
  weekday    Int?
  start_time DateTime?
  end_time   DateTime?

  group groups @relation(fields: [group_id], references: [id], onDelete: Cascade)
}

model student_groups {
  id         String    @id @default(uuid())
  student_id String
  group_id   String
  joined_at  DateTime?
  left_at    DateTime?
  status     String?

  student students @relation(fields: [student_id], references: [id], onDelete: Cascade)
  group   groups   @relation(fields: [group_id], references: [id], onDelete: Cascade)
}

model student_transfer {
  id          String   @id @default(uuid())
  student_id  String
  old_teacher String?
  new_teacher String?
  reason      String?
  created_at  DateTime @default(now())

  student         students  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  old_teacher_rel teachers? @relation("OldTeacher", fields: [old_teacher], references: [id], onDelete: SetNull)
  new_teacher_rel teachers? @relation("NewTeacher", fields: [new_teacher], references: [id], onDelete: SetNull)
}

model lessons {
  id          String    @id @default(uuid())
  group_id    String
  lesson_date DateTime?
  started_at  DateTime?
  ended_at    DateTime?
  status      String?

  group groups @relation(fields: [group_id], references: [id], onDelete: Cascade)

  attendance attendance[]
  ratings    ratings[]
}

model attendance {
  id           String   @id @default(uuid())
  lesson_id    String
  student_id   String
  status       String?
  late_minutes Int?
  penalty      Boolean?
  reason       String?

  lesson  lessons  @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  student students @relation(fields: [student_id], references: [id], onDelete: Cascade)

  call_logs call_logs[]
}

model call_logs {
  id            String    @id @default(uuid())
  student_id    String
  attendance_id String?
  operator      String?
  result        String?
  reason        String?
  called_at     DateTime?

  student       students    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  attendance    attendance? @relation(fields: [attendance_id], references: [id], onDelete: SetNull)
  operator_user users?      @relation(fields: [operator], references: [id], onDelete: SetNull)
}

model ratings {
  id         String  @id @default(uuid())
  lesson_id  String
  student_id String
  teacher_id String
  score      Int?
  comment    String?

  lesson  lessons  @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  student students @relation(fields: [student_id], references: [id], onDelete: Cascade)
  teacher teachers @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
}

model finance_accounts {
  id              String   @id @default(uuid())
  student_id      String
  balance         Decimal?
  debt            Decimal?
  advance_payment Decimal?
  due_day         Int?
  status          String?

  student students @relation(fields: [student_id], references: [id], onDelete: Cascade)

  payments payments[]
}

model payments {
  id                 String    @id @default(uuid())
  finance_account_id String
  amount             Decimal?
  payment_type       String?
  paid_at            DateTime?
  cashier            String?

  finance_account finance_accounts @relation(fields: [finance_account_id], references: [id], onDelete: Cascade)
  cashier_user    users?           @relation(fields: [cashier], references: [id], onDelete: SetNull)
}

model discounts {
  id         String    @id @default(uuid())
  student_id String
  type       String?
  percent    Int?
  amount     Decimal?
  reason     String?
  start_date DateTime?
  end_date   DateTime?

  student students @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model grants {
  id         String    @id @default(uuid())
  student_id String
  type       String?
  percent    Int?
  sponsor    String?
  start_date DateTime?
  end_date   DateTime?

  student students @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model homeworks {
  id          String    @id @default(uuid())
  group_id    String
  teacher_id  String
  title       String
  description String?
  due_date    DateTime?
  created_at  DateTime  @default(now())

  group       groups                 @relation(fields: [group_id], references: [id], onDelete: Cascade)
  teacher     teachers               @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  submissions homework_submissions[]
}

model expenses {
  id          String   @id @default(uuid())
  branch_id   String
  category    String
  amount      Decimal
  date        DateTime @default(now())
  description String?

  branch branches @relation(fields: [branch_id], references: [id], onDelete: Cascade)
}

model audit_logs {
  id         String   @id @default(uuid())
  user_id    String
  action     String
  target     String?
  details    String?
  created_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model exams {
  id          String   @id @default(uuid())
  title       String
  description String?
  duration    Int?     // minutes
  group_id    String
  teacher_id  String
  status      String   @default("ACTIVE") // DRAFT, ACTIVE, COMPLETED
  created_at  DateTime @default(now())

  group       groups   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  teacher     teachers @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  questions   exam_questions[]
  results     exam_results[]
}

model exam_questions {
  id            String   @id @default(uuid())
  exam_id       String
  question_text String
  options       String   // JSON string of options array ["A", "B", "C", "D"]
  correct_index Int      // Index of correct option (0, 1, 2, 3)

  exam          exams    @relation(fields: [exam_id], references: [id], onDelete: Cascade)
}

model exam_results {
  id          String   @id @default(uuid())
  exam_id     String
  student_id  String
  score       Int      // How many correct
  is_passed   Boolean  // score >= 14
  answers     String   // JSON string of their answers
  submitted_at DateTime @default(now())

  exam        exams    @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student     students @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model direct_messages {
  id          String   @id @default(uuid())
  sender_id   String
  receiver_id String
  text        String
  created_at  DateTime @default(now())
}

model homework_submissions {
  id           String    @id @default(uuid())
  homework_id  String
  student_id   String
  solution_url String?
  content      String?
  status       String    @default("SUBMITTED") // SUBMITTED, CHECKED, REJECTED
  score        Int?
  feedback     String?
  submitted_at DateTime  @default(now())

  homework homeworks @relation(fields: [homework_id], references: [id], onDelete: Cascade)
  student  students  @relation(fields: [student_id], references: [id], onDelete: Cascade)
}
